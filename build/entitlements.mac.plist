<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs both JIT and unsigned executable memory under the
       hardened runtime; V8 will not start without them. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The preload script and the packaged asar are loaded at runtime, which
       the hardened runtime otherwise treats as library validation failures. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- run_command spawns a shell; without this the child is killed on exec. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
